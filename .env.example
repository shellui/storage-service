# App runtime
# Required. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-12345678901234567890123456789012
STORAGE_SERVICE_PORT=8001
DEBUG=true
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
POSTGRES_DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:5174,http://localhost:5175,https://admin.shellui.com

# ---------------------------------------------------------------------------
# Identity JWKS — where storage-service fetches public keys to verify JWTs
# Set ONE of these (IDENTITY_JWKS_URL wins if both are set).
#
# Local identity-service:
IDENTITY_JWKS_URL=http://localhost:8000/.well-known/jwks.json
#
# Production (id.shellui.com):
# IDENTITY_JWKS_URL=https://id.shellui.com/.well-known/jwks.json
#
# Or only the base URL (JWKS path is appended automatically):
# IDENTITY_SERVICE_URL=https://id.shellui.com
# IDENTITY_JWKS_URL=
# ---------------------------------------------------------------------------
IDENTITY_SERVICE_URL=
IDENTITY_ISSUER=
IDENTITY_AUDIENCE=
JWKS_CACHE_TTL=900
# Seconds to wait for identity JWKS (prod can be slow). Extra attempts after a timeout.
JWKS_TIMEOUT=15
JWKS_RETRIES=2
# Local/dev: set to identity-service SECRET_KEY when that service uses HS256 (DEBUG=true, empty JWKS)
JWT_HS256_FALLBACK_SECRET=
JWT_ALGORITHMS=RS256

# Object storage: filesystem (local disk) or s3 (AWS / MinIO / Cloudflare R2 / …)
STORAGE_BACKEND=filesystem
MEDIA_ROOT=
STORAGE_KEY_PREFIX=shellui

# S3 / MinIO / OVH (when STORAGE_BACKEND=s3)
# Endpoint is scheme+host only — no path such as /api/v3.
# OVH Paris example:
#   AWS_S3_ENDPOINT_URL=https://s3.eu-west-par.io.cloud.ovh.net
#   AWS_S3_REGION_NAME=eu-west-par
#   AWS_S3_ADDRESSING_STYLE=virtual
# MinIO in Compose: http://minio:9000 and AWS_S3_ADDRESSING_STYLE=path
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
# Leave empty unless you have a real CDN. Do not set this to the S3 API hostname.
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_SIGNATURE_VERSION=s3v4
# path (MinIO) or virtual (OVH / AWS). Empty = inferred from the endpoint.
AWS_S3_ADDRESSING_STYLE=

# Optional signed URLs (POST /storage/v1/object/sign/...). Object GET always streams.
SIGNED_URL_EXPIRES=3600

# Quotas (suffixes K/M/G/T allowed)
DEFAULT_COMPANY_QUOTA_BYTES=10G
DEFAULT_USER_QUOTA_BYTES=0
MAX_UPLOAD_BYTES=5G

# WebDAV (third-party file clients)
WEBDAV_ENABLED=true
WEBDAV_PATH_PREFIX=/dav

# Sentry (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
