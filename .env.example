# storage-service settings. Full reference: docs/configuration.md
# Generated from config/env_registry.py: python manage.py generate_env --example > .env.example
# Production: python manage.py generate_env --host storage.example.com
# Copy to .env for local runs. Commented-out lines show the default the code uses.

# Required
# Signs sessions and CSRF tokens. At least 50 characters when DEBUG=false.
SECRET_KEY=
# Local development only. Unset means false (production).
DEBUG=true
# Public host names, comma-separated, no scheme.
ALLOWED_HOSTS=localhost,127.0.0.1
# Local identity-service. JWKS is read from {url}/.well-known/jwks.json.
IDENTITY_SERVICE_URL=http://localhost:8000

# Required when DEBUG=false (production)
IDENTITY_ISSUER=
IDENTITY_AUDIENCE=
REDIS_URL=
CSRF_TRUSTED_ORIGINS=

# Optional (defaults shown)

# Runtime
# LOG_LEVEL=INFO
# SETUP_TOKEN=
# DJANGO_ADMIN_ENABLED=true
# STORAGE_SERVICE_PORT=8001

# Database: SQLite unless POSTGRES_DATABASE_URL is set
# POSTGRES_DATABASE_URL=
# SQLITE_PATH=db.sqlite3
# POSTGRES_SSL_REQUIRE=true

# Identity and JWT. Pin the JWKS with a file or JSON in production.
# IDENTITY_JWKS_FILE=
# IDENTITY_JWKS=
# IDENTITY_JWKS_URL=
# JWKS_CACHE_TTL=900
# JWKS_TIMEOUT=15
# JWKS_RETRIES=2
# JWT_ALGORITHMS=RS256
# JWT_HS256_FALLBACK_SECRET=
# ALLOW_JWT_HS256_FALLBACK=false

# Object storage: filesystem or s3
# STORAGE_BACKEND=filesystem
# MEDIA_ROOT=data/media
# STORAGE_KEY_PREFIX=shellui
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=
# AWS_S3_CUSTOM_DOMAIN=
# AWS_S3_SIGNATURE_VERSION=s3v4
# AWS_S3_ADDRESSING_STYLE=
# SIGNED_URL_EXPIRES=3600

# Quotas and uploads (K, M, G, T suffixes)
# DEFAULT_COMPANY_QUOTA_BYTES=10G
# DEFAULT_USER_QUOTA_BYTES=0
# MAX_UPLOAD_BYTES=5G
# DATA_UPLOAD_MAX_MEMORY_SIZE=12M

# WebDAV
# WEBDAV_ENABLED=true
# WEBDAV_PATH_PREFIX=/dav

# Scheduled jobs
# SCHEDULER_ENABLED=true
# CELERY_BROKER_URL=
# CELERY_WORKER_CONCURRENCY=2
# CELERY_BEAT_SCHEDULE_FILE=/tmp/celerybeat-schedule

# CORS and HTTPS
# CORS_ALLOW_ALL_ORIGINS=true
# CORS_ALLOW_CREDENTIALS=false
# CORS_ALLOWED_ORIGINS=
# CORS_ALLOW_PRIVATE_NETWORK=true
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=false
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true

# Shellui Actions (outbound webhooks)
# ACTIONS_WEBHOOK_TIMEOUT_SECONDS=5
# ACTIONS_OUTBOX_MAX_ATTEMPTS=8
# ACTIONS_WEBHOOK_ALLOW_PRIVATE=false
# ACTIONS_WEBHOOK_RETRY_LEASE_SECONDS=120
# ACTIONS_WEBHOOK_DISPATCH_WORKERS=4
# ACTIONS_WEBHOOK_SYNC_DELIVERY=false
# EVENT_LOG_RETENTION_DAYS=7

# Email notifications: nothing is forwarded while EMAIL_SERVICE_API_KEY is empty
# EMAIL_SERVICE_API_KEY=
# EMAIL_SERVICE_URL=https://email.shellui.com
# EMAIL_SERVICE_ALLOW_PRIVATE=false

# Sentry
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0

# Gunicorn (Docker entrypoint)
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=120
# GUNICORN_GRACEFUL_TIMEOUT=30
# GUNICORN_KEEP_ALIVE=75
# GUNICORN_MAX_REQUESTS=1000
# GUNICORN_MAX_REQUESTS_JITTER=200
