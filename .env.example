# App runtime
# Required. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
STORAGE_SERVICE_PORT=8001
DEBUG=true
# One-time web bootstrap token for creating the first superuser when DEBUG=false.
# Leave empty and use `uv run python manage.py createsuperuser` in production.
# When set, open `/?setup_token=<token>` once to use the web form.
SETUP_TOKEN=
# DEBUG, INFO, WARNING, ERROR. Default is DEBUG when DEBUG=true, otherwise INFO.
LOG_LEVEL=DEBUG
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
POSTGRES_DATABASE_URL=
# Require TLS for Postgres when DEBUG=false (default). Set false only for internal DB (e.g. Coolify).
POSTGRES_SSL_REQUIRE=
# HTTPS / cookie hardening (defaults follow DEBUG=false in production)
SECURE_SSL_REDIRECT=
SECURE_HSTS_SECONDS=
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
# API CORS: multi-tenant shells call /storage/v1/* from unknown browser origins (Bearer JWT, no cookies).
# Default allow-all is intentional; OAuth redirect allowlist on identity is the token-delivery boundary.
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOW_CREDENTIALS=false
# Optional lock-down (first-party-only): set CORS_ALLOW_ALL_ORIGINS=false and list origins:
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:5174,http://localhost:5175,https://admin.shellui.com

# ---------------------------------------------------------------------------
# Identity JWKS — public keys used to verify JWTs (not a private certificate).
# Prefer IDENTITY_SERVICE_URL; JWKS is derived as {url}/.well-known/jwks.json.
# Override with IDENTITY_JWKS_URL only if JWKS lives on a different host.
# Production: pin keys locally (no runtime HTTP to identity):
#   IDENTITY_JWKS_FILE=/app/data/jwks.json
#   IDENTITY_JWKS={"keys":[...]}  # from: curl -s https://id.shellui.com/.well-known/jwks.json
#
# Local identity-service:
IDENTITY_SERVICE_URL=http://localhost:8000
IDENTITY_JWKS_URL=
IDENTITY_JWKS_FILE=
IDENTITY_JWKS=
# Required in production (DEBUG=false). Must match identity-service JWT_ISSUER / JWT_AUDIENCE (0.5.0+).
IDENTITY_ISSUER=
IDENTITY_AUDIENCE=
JWKS_CACHE_TTL=900
# Seconds to wait for identity JWKS (prod can be slow). Extra attempts after a timeout.
JWKS_TIMEOUT=15
JWKS_RETRIES=2
# Local/dev: set to identity-service SECRET_KEY when that service uses HS256 (DEBUG=true, empty JWKS)
JWT_HS256_FALLBACK_SECRET=
JWT_ALGORITHMS=RS256

# Object storage: filesystem (local disk) or s3 (AWS / MinIO / Cloudflare R2 / …)
STORAGE_BACKEND=filesystem
MEDIA_ROOT=
STORAGE_KEY_PREFIX=shellui

# S3 / MinIO / OVH (when STORAGE_BACKEND=s3)
# Endpoint is scheme+host only — no path such as /api/v3.
# OVH Paris example:
#   AWS_S3_ENDPOINT_URL=https://s3.eu-west-par.io.cloud.ovh.net
#   AWS_S3_REGION_NAME=eu-west-par
#   AWS_S3_ADDRESSING_STYLE=virtual
# MinIO in Compose: http://minio:9000 and AWS_S3_ADDRESSING_STYLE=path
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
# Leave empty unless you have a real CDN. Do not set this to the S3 API hostname.
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_SIGNATURE_VERSION=s3v4
# path (MinIO) or virtual (OVH / AWS). Empty = inferred from the endpoint.
AWS_S3_ADDRESSING_STYLE=

# Optional signed URLs (POST /storage/v1/object/sign/...). Object GET always streams.
SIGNED_URL_EXPIRES=3600

# Quotas (suffixes K/M/G/T allowed)
DEFAULT_COMPANY_QUOTA_BYTES=10G
DEFAULT_USER_QUOTA_BYTES=0
MAX_UPLOAD_BYTES=5G

# WebDAV (third-party file clients)
WEBDAV_ENABLED=true
WEBDAV_PATH_PREFIX=/dav

# Django admin (cross-tenant operator UI). Set false on public API pods; use MFA + network lock.
DJANGO_ADMIN_ENABLED=true

# Sentry (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
